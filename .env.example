# Optional database: leave both values empty for in-memory rate limiting.
# Example only: postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/roiqr
DATABASE_URL=""
DIRECT_URL=""

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
BATCH_MAX_QR=500

# Set this to your own public origin before building a deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
